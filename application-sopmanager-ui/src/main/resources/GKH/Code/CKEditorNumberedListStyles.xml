    <property>
      <code>/* The numbered lists whose numbers are closed by a parenthesis ("1)", "a)", "A)", "i)", "I)"), chosen in the Numbered
   List Properties dialog of the WYSIWYG editor. The lists stay ordered lists and keep their start. */
@counter-style gkh-decimal-parenthesis {
  system: extends decimal;
  suffix: ") ";
}
@counter-style gkh-lower-alpha-parenthesis {
  system: extends lower-alpha;
  suffix: ") ";
}
@counter-style gkh-upper-alpha-parenthesis {
  system: extends upper-alpha;
  suffix: ") ";
}
@counter-style gkh-lower-roman-parenthesis {
  system: extends lower-roman;
  suffix: ") ";
}
@counter-style gkh-upper-roman-parenthesis {
  system: extends upper-roman;
  suffix: ") ";
}</code>
