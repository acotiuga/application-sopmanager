    <property>
      <code>// Add the numbered list types closed by a parenthesis ("1), 2), 3)", "a), b), c)"...) to the Numbered List Properties
// dialog of the WYSIWYG editor. The numbers are drawn by the counter styles of GKH.Code.CKEditorNumberedListStyles.
require(['deferred!ckeditor'], function(ckeditorPromise) {
  ckeditorPromise.done(function(ckeditor) {
    var listTypes = [
      ['1), 2), 3)', 'gkh-decimal-parenthesis'],
      ['a), b), c)', 'gkh-lower-alpha-parenthesis'],
      ['A), B), C)', 'gkh-upper-alpha-parenthesis'],
      ['i), ii), iii)', 'gkh-lower-roman-parenthesis'],
      ['I), II), III)', 'gkh-upper-roman-parenthesis']
    ];
    ckeditor.on('dialogDefinition', function(event) {
      if (event.data.name !== 'numberedListStyle') {
        return;
      }
      var infoTab = event.data.definition.getContents('info');
      var typeField = infoTab &amp;&amp; infoTab.get('type');
      if (!typeField) {
        return;
      }
      // The dialog definition may be extended more than once: add each type only once.
      listTypes.forEach(function(listType) {
        if (!typeField.items.some(function(item) {
          return item[1] === listType[1];
        })) {
          typeField.items.push(listType);
        }
      });
    });
  });
});</code>
