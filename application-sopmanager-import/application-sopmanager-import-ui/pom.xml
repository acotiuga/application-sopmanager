<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xwiki.contrib</groupId>
    <artifactId>application-sopmanager-import</artifactId>
    <version>1.0rc22-SNAPSHOT</version>
  </parent>
  <artifactId>application-sopmanager-import-ui</artifactId>
  <name>SOP Manager Application - Import - UI</name>
  <description>The page importing the documents of a folder of the server (Word documents, Word 97-2003 documents, PDF documents) as SOP documents, after their analysis and preview. Meant to be uninstalled once the documents are imported.</description>
  <packaging>xar</packaging>
  <properties>
    <!-- Name to display by the Extension Manager -->
    <xwiki.extension.name>SOP Manager Import</xwiki.extension.name>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.xwiki.contrib</groupId>
      <artifactId>application-sopmanager-ui</artifactId>
      <version>${project.version}</version>
      <type>xar</type>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.xwiki.contrib</groupId>
      <artifactId>application-sopmanager-import-api</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The job macro, running the analysis and the import of the documents in the background with their progress and
         their log. It's built on XWiki 12.10, and uses an API kept by the legacy modules of XWiki: its dependencies are
         the ones of XWiki, already installed. -->
    <dependency>
      <groupId>org.xwiki.contrib</groupId>
      <artifactId>macro-job</artifactId>
      <version>2.2.2</version>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.xwiki.contrib</groupId>
      <artifactId>macro-job-ui</artifactId>
      <version>2.2.2</version>
      <type>xar</type>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.xwiki.commons</groupId>
        <artifactId>xwiki-commons-tool-xar-plugin</artifactId>
        <configuration>
          <visibleTechnicalPages>
            <visibleTechnicalPage>.*/SOPManager/ImportDocuments\.xml</visibleTechnicalPage>
          </visibleTechnicalPages>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
