<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xwiki.contrib</groupId>
    <artifactId>application-sopmanager-import</artifactId>
    <version>1.0rc22-SNAPSHOT</version>
  </parent>
  <artifactId>application-sopmanager-import-api</artifactId>
  <name>SOP Manager Application - Import - API</name>
  <description>Reads the documents to import as SOP documents, analyses their versions, and creates the SOP documents.</description>
  <properties>
    <xwiki.jacoco.instructionRatio>0.83</xwiki.jacoco.instructionRatio>
    <!-- A new module: there is no previous release to compare its API with. -->
    <xwiki.revapi.skip>true</xwiki.revapi.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.xwiki.contrib</groupId>
      <artifactId>application-sopmanager-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-oldcore</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- Imports the Word 97-2003 documents, converted by the office server. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-office-importer</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- Imports the PDF documents, from their structure. The version used by XWiki (e.g. for the indexing of the
         attachments). -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
    </dependency>
    <!-- Test dependencies -->
    <dependency>
      <groupId>org.xwiki.commons</groupId>
      <artifactId>xwiki-commons-tool-test-component</artifactId>
      <version>${commons.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>4.0.1</version>
      <scope>test</scope>
    </dependency>
    <!-- The rendering components, used by the tests to render the content of the imported documents, load the servlet
         container components. -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
